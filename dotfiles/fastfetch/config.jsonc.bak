{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "         ███▄  ▄███▓  ██▒    █▓ ▄▄▄█████▓ ▄▄▄█████▓\n        ▓██▒▀█▀ ██▒ ▓██░    █▒ ▓  ██▒ ▓▒ ▓  ██▒ ▓▒\n        ▓██     ▓██░  ▓██   █▒░ ▒ ▓██░ ▒░ ▒ ▓██░ ▒░\n        ▒██     ▒██    ▒██  █░░ ░ ▓██▓ ░  ░ ▓██▓ ░\n        ▒██▒    ░██▒    ▒▀█░     ▒██▒ ░    ▒██▒ ░\n        ░ ▒░    ░  ░    ░ ▐░     ▒ ░░      ▒ ░░\n        ░  ░       ░    ░ ░░       ░         ░\n        ░       ░         ░░     ░         ░\n              ░          ░\n                       ░",
    "color": {
      "1": "magenta"
    },
    "padding": {
      "left": 10,
      "right": 30,
      "top": 6
    }
  },
  "display": {
    "separator": "|   ",
    "color": {
      "separator": "magenta"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "┌───────────────────────────────────────────────────────────────────────────────────────┐"
    },
    "break",
    {
      "key": "     OS          ",
      "keyColor": "green",
      "type": "os"
    },
    {
      "key": "    󰌢 Machine     ",
      "keyColor": "cyan",
      "type": "host"
    },
    {
      "key": "     Kernel      ",
      "keyColor": "blue",
      "type": "kernel"
    },
    {
      "key": "    󰅐 Uptime      ",
      "keyColor": "green",
      "type": "uptime"
    },
    {
      "key": "     Packages    ",
      "keyColor": "cyan",
      "type": "packages"
    },
    {
      "key": "    󰍹 DE          ",
      "keyColor": "blue",
      "type": "de"
    },
    {
      "key": "     WM          ",
      "keyColor": "green",
      "type": "wm"
    },
    {
      "key": "     Shell       ",
      "keyColor": "cyan",
      "type": "shell"
    },
    {
      "key": "     Terminal    ",
      "keyColor": "blue",
      "type": "terminal"
    },
    {
      "key": "     Font        ",
      "keyColor": "green",
      "type": "terminalfont"
    },
    {
      "key": "    󰻠 CPU         ",
      "keyColor": "cyan",
      "type": "cpu"
    },
    {
      "key": "    󰍛 GPU         ",
      "keyColor": "blue",
      "type": "gpu"
    },
    {
      "key": "    󰋊 Disk        ",
      "keyColor": "green",
      "type": "disk",
      "folders": "/"
    },
    {
      "key": "     Wifi        ",
      "keyColor": "cyan",
      "type": "wifi"
    },
    {
      "key": "    󰩟 Local IP    ",
      "keyColor": "blue",
      "type": "localip",
      "compact": true
    },
    {
      "key": "    󰎆 Media       ",
      "keyColor": "green",
      "type": "media"
    },
    {
      "key": "    󰃰 DateTime    ",
      "keyColor": "cyan",
      "type": "datetime",
      "format": "{1}-{2}-{3} {4}:{5}"
    },
    "break",
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 34,
      "symbol": "circle",
      "block": {
        "width": 10
      }
    }
  ]
}
